{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // DOM is here only so the functions we hand to page.evaluate() type-check;
    // they execute inside the remote browser, never in Node.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["src", "scripts"]
}
