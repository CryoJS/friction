{
  "name": "friction",
  "private": true,
  "version": "0.1.0",
  "description": "Friction: an AI agent attempts a task on a live site, finds the UX friction, and proves which fixes remove it.",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "dev:worker": "pnpm --filter @friction/worker dev",
    "dev:orchestrator": "pnpm --filter @friction/orchestrator dev",
    "dev:control-room": "pnpm --filter @friction/control-room dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm --filter @friction/control-room build",
    "build:demo": "tsx scripts/build-demo.ts",
    "preview:demo": "pnpm --filter @friction/control-room preview",
    "golden:generate": "tsx scripts/generate-golden.ts",
    "db:migrate:local": "pnpm --filter @friction/worker db:migrate:local",
    "db:migrate:remote": "pnpm --filter @friction/worker db:migrate:remote",
    "deploy:worker": "pnpm --filter @friction/worker deploy",
    "deploy:pages": "pnpm build:demo && pnpm --filter @friction/control-room exec wrangler pages deploy dist --project-name friction"
  },
  "devDependencies": {
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
