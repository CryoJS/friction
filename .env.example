# Copy to .env (repo root) or apps/orchestrator/.env. Only the orchestrator reads this file.
# With nothing set, the orchestrator runs in MOCK mode and the whole repo still works end to end.

# --- OpenAI (required for live runs) -----------------------------------------
OPENAI_API_KEY=
# REQUIRED, and deliberately has no default: the model name is never hardcoded anywhere.
# Must support the Responses API with image input, function calling and Structured Outputs.
OPENAI_MODEL=

# Optional. Model for Stagehand's own observe() fallback. Defaults to OPENAI_MODEL.
# STAGEHAND_MODEL=
# Optional. Only set for reasoning models that accept it: low | medium | high
# OPENAI_REASONING_EFFORT=
# Optional. Screenshot detail sent to the model: high (default) | low | auto
# OPENAI_IMAGE_DETAIL=high

# --- Browserbase (required for live runs unless BROWSER_ENV=LOCAL) ------------
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Optional: us-west-2 | us-east-1 | eu-central-1 | ap-southeast-1
# BROWSERBASE_REGION=

# --- Orchestrator -------------------------------------------------------------
# Where the Cloudflare Worker is. Local default shown; use your workers.dev URL once deployed.
WORKER_URL=http://127.0.0.1:8787
PORT=8788

# BROWSERBASE (default) or LOCAL. LOCAL drives a Chrome/Edge on this machine: no live view and
# no session replay, but it needs no Browserbase key and burns no Browserbase minutes.
# BROWSER_ENV=LOCAL
# LOCAL_BROWSER_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Force mock mode even when keys are present (demo fallback if the venue network blocks Browserbase).
# FRICTION_MOCK=1
# Mock mode replays the golden run this many times faster than recorded (default 3).
# MOCK_SPEED=3

# Browser sessions open at once across every run and scan (1-100, default 5): a scan's crawl,
# every primary run and every fix verification take one. Set it to your Browserbase plan's
# concurrency limit. (PERSONA_CONCURRENCY, the old name, is still read as a fallback.)
# MAX_SESSIONS=5

# --- Crawl (Browserbase Fetch pre-pass) ----------------------------------------
# A scan's crawl surveys the site with Browserbase's Fetch API first: raw HTML,
# about $1 per 1000 pages, no browser session at all. Only the pages Fetch cannot
# honestly read (client-rendered shells, 502s) and the most interactive flows get
# a real session.
# Pages surveyed over Fetch, landing page included (0-200). 0 turns the pre-pass
# off: the crawl is then the session-based one it always was.
# CRAWL_FETCH_MAX=20
# Most surveyed pages that earn a browser (0-6). One session is opened and reused
# for all of them.
# CRAWL_SESSION_MAX=3

# --- Fix verification ----------------------------------------------------------
# How many of a run's findings get a fix proposed and verified: fixable findings
# (an element misbehaves) first, symptoms (loop, step_budget, long_wait) only in
# slots left over. Each verification is a full extra browser run. 0 turns
# verification off; at most 5.
# VERIFY_TOP_N=3
# Cap on one run's verifications, first attempts and retries together (1-10). A
# fix that ran and was rejected with "still fires" is retried once while under it.
# VERIFY_MAX_RUNS=4
# Every mapped fix gets a Playwright regression test, proven in a browser (fails
# on the site as it is, passes with the patch) and added to the pull request
# under tests/friction/. One model call and two short sessions each. 0 turns it off.
# PR_TESTS=1

# --- Pull requests (optional) -----------------------------------------------------
# THE EASY WAY: a Connect GitHub button. Register a GitHub OAuth App (Settings ->
# Developer settings -> OAuth Apps), tick "Enable Device Flow", and put its PUBLIC
# client ID here. No token to make and no repositories to list: you connect in the
# scan form and tick the repositories Friction may open pull requests against.
# GITHUB_CLIENT_ID=
#
# BY HAND (works exactly as before, and is what is used while nothing is connected):
# A personal access token with contents + pull requests write access to ONE repository.
# With these set, verified fixes are mapped to a source file and a draft PR can be
# opened from the control room: by clicking, or, for a scan started with a
# repository and "Open draft pull requests automatically", one per fixable task.
# Use a fine-grained token scoped to exactly these repositories (Contents and
# Pull requests: read and write). The orchestrator has no auth: never expose it
# publicly while this token can write.
# GITHUB_TOKEN=
# GITHUB_OWNER=
# GITHUB_REPO=
# Branch PRs are opened against. Defaults to the repository's default branch.
# GITHUB_BASE_BRANCH=main
# More repositories a scan may choose, comma-separated owner/name. A scan can
# only ever name GITHUB_OWNER/GITHUB_REPO or one of these.
# GITHUB_ALLOWED_REPOS=
# 1: preview pull requests, never push. Reads GitHub, writes nothing.
# GITHUB_DRY_RUN=1

# Hard cap is 15 steps per agent run. This can lower it, never raise it.
# MAX_STEPS=15
# Wall-clock budget per agent run (primary or verify) in ms (default 300000).
# AGENT_TIMEOUT_MS=300000
